{
	"info": {
		"_postman_id": "indomaret-backend-test-collection",
		"name": "Klik Indomaret Backend API",
		"description": "Postman Collection untuk Technical Assignment Backend Developer Klik Indomaret",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data.token) {",
									"    pm.environment.set('token', jsonData.data.token);",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "2. Store Management",
			"item": [
				{
					"name": "Search Stores (With Whitelist Merge)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/stores/search?province=Jawa Barat&page=0&size=20",
							"host": ["{{baseUrl}}"],
							"path": ["stores", "search"],
							"query": [
								{ "key": "province", "value": "Jawa Barat" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "20" }
							]
						}
					}
				},
				{
					"name": "Get Store by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/stores/1",
							"host": ["{{baseUrl}}"],
							"path": ["stores", "1"]
						}
					}
				}
			]
		},
		{
			"name": "3. Branch Management",
			"item": [
				{
					"name": "Get All Active Branches",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/branches",
							"host": ["{{baseUrl}}"],
							"path": ["branches"]
						}
					}
				},
				{
					"name": "Update Branch (With Audit Log)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Cabang Bandung Juanda\",\n    \"address\": \"Jl. Ir. H. Juanda No. 100, Bandung\",\n    \"provinceId\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/branches/1",
							"host": ["{{baseUrl}}"],
							"path": ["branches", "1"]
						}
					}
				},
				{
					"name": "Soft Delete Branch",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/branches/3",
							"host": ["{{baseUrl}}"],
							"path": ["branches", "3"]
						}
					}
				}
			]
		},
		{
			"name": "4. Whitelist Store Management",
			"item": [
				{
					"name": "Get All Active Whitelist Stores",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/whitelist-stores",
							"host": ["{{baseUrl}}"],
							"path": ["whitelist-stores"]
						}
					}
				},
				{
					"name": "Add Store to Whitelist",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"storeId\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/whitelist-stores",
							"host": ["{{baseUrl}}"],
							"path": ["whitelist-stores"]
						}
					}
				},
				{
					"name": "Remove Store from Whitelist",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/whitelist-stores/1",
							"host": ["{{baseUrl}}"],
							"path": ["whitelist-stores", "1"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api"
		},
		{
			"key": "token",
			"value": ""
		}
	]
}
